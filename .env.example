# ShrooomzEye Environment Configuration
# Copy this file to .env and fill in your actual values

# Database connection string
# Format: postgres://[user]:[password]@[host]:[port]/[database]
# For Neon: DATABASE_URL=postgresql://user:password@xxx.neon.tech/dbname
DATABASE_URL=postgres://postgres:password@localhost:5432/shrooomzeye

# Server port (default: 5000)
PORT=5000

# Node environment (development or production)
NODE_ENV=development

# Optional: Background job intervals (in minutes for cron jobs, seconds for scrapers)
# Death Tracker - check online players (minutes, default dev=5, prod=1)
DEATH_TRACKER_ONLINE_MIN=5

# Death Tracker - check offline players (minutes, default dev=120, prod=15)
DEATH_TRACKER_OFFLINE_MIN=120

# Online Players Scraper (seconds, default dev=300, prod=60)
ONLINE_SCRAPER_SEC=300

# Guild sync scheduler (minutes, default=15)
GUILD_SYNC_MIN=15

